<script>
  document.addEventListener('DOMContentLoaded', () => {
      // Section Nav Elements
      const sectionNav = document.getElementById('sectionNav');
      const closeBtn = document.getElementById('closeNav');
      const reopenTrigger = document.getElementById('reopenTrigger');

      // Toggle Section Nav
      const toggleSectionNav = (open) => {
          if(open) {
              sectionNav.classList.remove('hidden');
              reopenTrigger.classList.add('hidden');
              localStorage.setItem('navClosed', 'false');
          } else {
              sectionNav.classList.add('hidden');
              reopenTrigger.classList.remove('hidden');
              localStorage.setItem('navClosed', 'true');
          }
      };

      // Close Button Handler
      closeBtn.addEventListener('click', () => toggleSectionNav(false));

      // Reopen Trigger Handler
      reopenTrigger.addEventListener('click', () => {
          toggleSectionNav(true);
          // Scroll to show the nav if it's off-screen
          window.scrollTo({
              top: 0,
              behavior: 'smooth'
          });
      });

      // Check localStorage for saved preference
      if(localStorage.getItem('navClosed') === 'false') {
          toggleSectionNav(true);
      }

      // Hide nav on scroll down, show on scroll up
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
          const currentScroll = window.pageYOffset;
          if (currentScroll > lastScroll && currentScroll > 100) {
              // Scrolling down
              sectionNav.classList.add('opacity-0', 'pointer-events-none');
              sectionNav.classList.add('hidden');
          } else {
              // Scrolling up
              sectionNav.classList.remove('hidden');
              reopenTrigger.classList.add('hidden');
              sectionNav.classList.remove('opacity-0', 'pointer-events-none');
              
          }
          lastScroll = currentScroll;
      });
  });
</script>

